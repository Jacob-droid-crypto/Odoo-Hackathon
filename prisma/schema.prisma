// Prisma Schema for Subscription Management System (Brightloop Software)
// Designed for PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  ADDON
  SERVICE
  PHYSICAL
}

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountTarget {
  PRODUCT
  SUBSCRIPTION
  INVOICE
}

enum PaymentMethod {
  CREDIT_CARD
  CARD
  UPI
  BANK_TRANSFER
  STRIPE
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// -----------------------------------------------------------------------------
// USER & AUTHENTICATION (Member 2 Responsibility)
// -----------------------------------------------------------------------------

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                  Role           @default(CUSTOMER)
  companyName           String?
  phone                 String?
  isActive              Boolean        @default(true)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations for other modules
  subscriptions         Subscription[]
  quotations            Quotation[]
  invoices              Invoice[]
  payments              Payment[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// PRODUCTS & VARIANTS (Member 2 Responsibility)
// -----------------------------------------------------------------------------

model Product {
  id            String           @id @default(uuid())
  name          String
  type          ProductType      @default(SOFTWARE)
  salesPrice    Decimal          @db.Decimal(12, 2)
  costPrice     Decimal          @default(0.00) @db.Decimal(12, 2)
  notes         String?          @db.Text
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  variants          ProductVariant[]
  plans             SubscriptionPlan[]
  subscriptionLines SubscriptionLine[]
  quotationLines    QuotationLine[]
  invoiceLines      InvoiceLine[]

  @@map("products")
}

model ProductVariant {
  id              String           @id @default(uuid())
  productId       String
  variantName     String           // e.g. "Brand: Odoo" or "Pro Edition"
  attributeName   String           // e.g. "Brand", "Edition", "Storage"
  attributeValue  String           // e.g. "Odoo", "Enterprise"
  priceExtra      Decimal          @default(0.00) @db.Decimal(12, 2) // e.g. 560.00
  sku             String?          @unique
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionLines SubscriptionLine[]
  quotationLines    QuotationLine[]
  invoiceLines      InvoiceLine[]

  @@index([productId])
  @@map("product_variants")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTION PLANS (Member 2 Responsibility)
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id                String           @id @default(uuid())
  productId         String
  name              String           // e.g. "Business Software Monthly"
  code              String           @unique // e.g. "BS-MONTHLY"
  description       String?          @db.Text
  price             Decimal          @db.Decimal(12, 2)
  billingInterval   BillingInterval  @default(MONTHLY) // DAILY, WEEKLY, MONTHLY, YEARLY
  intervalCount     Int              @default(1) // e.g., every 1 month, every 3 months
  minQuantity       Int              @default(1)
  startDate         DateTime?        // Validity start date
  endDate           DateTime?        // Validity end date
  autoClose         Boolean          @default(false) // Closes automatically when end date reached
  allowEarlyClose   Boolean          @default(true)
  allowPause        Boolean          @default(true)
  allowRenew        Boolean          @default(true)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  product           Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptions     Subscription[]
  quotations        Quotation[]

  @@index([productId])
  @@map("subscription_plans")
}

// -----------------------------------------------------------------------------
// QUOTATIONS & TEMPLATES (Coordinated Schema - Member 3)
// -----------------------------------------------------------------------------

model Quotation {
  id                String           @id @default(uuid())
  quotationNumber   String           @unique // e.g. "QT-2026-0001"
  customerId        String
  planId            String
  status            QuotationStatus  @default(DRAFT)
  validUntilDays    Int              @default(30)
  expirationDate    DateTime
  notes             String?          @db.Text
  totalAmount       Decimal          @default(0.00) @db.Decimal(12, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer          User             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan              SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines             QuotationLine[]
  subscriptions     Subscription[]

  @@index([customerId])
  @@index([planId])
  @@map("quotations")
}

model QuotationLine {
  id              String          @id @default(uuid())
  quotationId     String
  productId       String
  variantId       String?
  quantity        Int             @default(1)
  unitPrice       Decimal         @db.Decimal(12, 2)
  taxRate         Decimal         @default(0.00) @db.Decimal(5, 2)
  lineTotal       Decimal         @db.Decimal(12, 2)

  quotation       Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_lines")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTIONS (Coordinated Schema - Member 3)
// -----------------------------------------------------------------------------

model Subscription {
  id                  String             @id @default(uuid())
  subscriptionNumber  String             @unique // e.g. "SUB-2026-0001"
  customerId          String
  planId              String
  quotationId         String?
  quantity            Int                @default(1)
  unitPrice           Decimal?           @db.Decimal(12, 2)
  totalAmount         Decimal?           @db.Decimal(12, 2)
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime           @default(now())
  expiryDate          DateTime?
  nextBillingDate     DateTime?
  lastBillingDate     DateTime?
  paymentTerms        String?            // e.g. "Net 30", "Immediate"
  autoRenew           Boolean            @default(true)
  notes               String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  customer            User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan                SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotation           Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  lines               SubscriptionLine[]
  invoices            Invoice[]

  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

model SubscriptionLine {
  id              String          @id @default(uuid())
  subscriptionId  String
  productId       String
  variantId       String?
  quantity        Int             @default(1)
  unitPrice       Decimal         @db.Decimal(12, 2)
  taxRate         Decimal         @default(0.00) @db.Decimal(5, 2)
  amount          Decimal         @db.Decimal(12, 2)

  subscription    Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@map("subscription_lines")
}

// -----------------------------------------------------------------------------
// TAXES & DISCOUNTS (Coordinated Schema - Member 4)
// -----------------------------------------------------------------------------

model TaxRule {
  id              String      @id @default(uuid())
  name            String      // e.g. "Standard VAT", "State Sales Tax"
  ratePercentage  Decimal     @db.Decimal(5, 2) // e.g. 18.00
  description     String?
  isDefault       Boolean     @default(false)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("tax_rules")
}

model DiscountRule {
  id              String          @id @default(uuid())
  code            String          @unique // e.g. "BRIGHT10"
  description     String?
  type            DiscountType    @default(PERCENTAGE)
  value           Decimal         @db.Decimal(12, 2) // e.g. 10.00 (%) or 50.00 ($)
  minPurchase     Decimal?        @db.Decimal(12, 2)
  minQuantity     Int?
  startDate       DateTime?
  endDate         DateTime?
  maxUses         Int?
  usedCount       Int             @default(0)
  targetType      DiscountTarget  @default(SUBSCRIPTION)
  targetProductId String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("discount_rules")
}

// -----------------------------------------------------------------------------
// INVOICES & BILLING (Coordinated Schema - Member 4)
// -----------------------------------------------------------------------------

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique // e.g. "INV-2026-0001"
  subscriptionId     String?
  customerId         String
  status             InvoiceStatus @default(DRAFT)
  subtotal           Decimal       @default(0.00) @db.Decimal(12, 2)
  taxTotal           Decimal       @default(0.00) @db.Decimal(12, 2)
  discountTotal      Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal       @default(0.00) @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0.00) @db.Decimal(12, 2)
  outstandingAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  issuedDate         DateTime      @default(now())
  dueDate            DateTime
  paidAt             DateTime?
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer           User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines              InvoiceLine[]
  payments           Payment[]

  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id              String          @id @default(uuid())
  invoiceId       String
  productId       String?
  variantId       String?
  description     String
  quantity        Int             @default(1)
  unitPrice       Decimal         @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0.00) @db.Decimal(12, 2)
  lineTotal       Decimal         @db.Decimal(12, 2)

  invoice         Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// -----------------------------------------------------------------------------
// PAYMENTS (Coordinated Schema - Member 4)
// -----------------------------------------------------------------------------

model Payment {
  id              String        @id @default(uuid())
  paymentNumber   String        @unique // e.g. "PAY-2026-0001"
  invoiceId       String
  customerId      String
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(CREDIT_CARD)
  status          PaymentStatus @default(COMPLETED)
  paymentDate     DateTime      @default(now())
  referenceNote   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer        User          @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([customerId])
  @@map("payments")
}
